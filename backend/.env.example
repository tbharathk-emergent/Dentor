# Dentor backend configuration — copy to .env and edit.
# Process environment variables always override this file.

DENTOR_ENV=production
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dentor

# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED in production — platform owner login at /platform.
# If the account already exists with the default password, it is rotated to this value.
SUPER_ADMIN_EMAIL=superadmin@dentor.in
SUPER_ADMIN_PASSWORD=

# 0 = no demo clinic/data (production default). 1 = seed demo data (development).
SEED_DEMO=0

# JWT_EXPIRE_MINUTES=720
# CORS_ORIGINS=
# MAX_BODY_BYTES=16777216
