# Dentor backend configuration — copy to .env and edit.
# Process environment variables always override this file.

DENTOR_ENV=production
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dentor

# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED in production — platform owner login at /platform.
# If the account already exists with the default password, it is rotated to this value.
SUPER_ADMIN_EMAIL=superadmin@dentor.in
SUPER_ADMIN_PASSWORD=

# 0 = no demo clinic/data (production default). 1 = seed demo data (development).
SEED_DEMO=0

# JWT_EXPIRE_MINUTES=720
# CORS_ORIGINS=
# MAX_BODY_BYTES=16777216

# ---- Mobile apps ----
# OTP text messages for the patient app. Leave empty to refuse OTP requests (sign-up,
# OTP login and password reset stay unavailable). "webhook" POSTs {to, message, purpose}
# to SMS_WEBHOOK_URL with "Authorization: Bearer <SMS_WEBHOOK_TOKEN>".
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# A fixed verification code for dedicated test mobile numbers, to test the patient app without an SMS gateway.
# OTP_TEST_MOBILES is a comma-separated list (up to 20). Leave BOTH empty (the default) to keep it off. Only sign-up,
# code login and password reset accept it (never "Fetch"); it is refused for a number on a staff-registered patient
# record or on a real account; a test account only ever sees records it creates in the app. The code is never
# returned or logged. Use numbers nobody else uses; remove both lines and restart the API when testing is finished.
# OTP_TEST_MOBILES=9000000001,9000000002
# OTP_TEST_CODE=

# Test patient logins (email or mobile + password), independent of SMS and email services. Entries
# "email|mobile|password" separated by ";" (up to 20; passwords cannot contain | or ;). At start-up each becomes a
# test account (password stored as a hash) that only ever sees records it creates in the app; an entry whose email or
# number belongs to a real patient is skipped. Remove the line and restart the API to disable those accounts.
# PATIENT_TEST_ACCOUNTS=tester1@example.com|9000000001|<password>;tester2@example.com|9000000002|<password>

# Four-digit email codes (staff and patient password reset, staff sign-up). Development uses
# "console" (the code is logged and returned to the app). Production must use "webhook", which
# POSTs {to, subject, text, purpose} to EMAIL_WEBHOOK_URL with "Authorization: Bearer
# <EMAIL_WEBHOOK_TOKEN>"; left empty, email codes are refused and password sign-in still works.
# EMAIL_PROVIDER=webhook
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=

# Push notifications. Leave empty to keep notifications in-app only. "webhook" POSTs
# {devices: [{token, platform}], title, body, data} to PUSH_WEBHOOK_URL with
# "Authorization: Bearer <PUSH_WEBHOOK_TOKEN>" (your FCM / APNs adapter).
# PUSH_PROVIDER=webhook
# PUSH_WEBHOOK_URL=
# PUSH_WEBHOOK_TOKEN=

# PATIENT_ACCESS_MINUTES=60
# REFRESH_TOKEN_DAYS=30
# OTP_TTL_SECONDS=300
# OTP_MAX_PER_HOUR=5
