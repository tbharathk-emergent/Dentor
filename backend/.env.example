# Dentor backend configuration — copy to .env and edit.
# Process environment variables always override this file.

DENTOR_ENV=production
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dentor

# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED in production — platform owner login at /platform.
# If the account already exists with the default password, it is rotated to this value.
SUPER_ADMIN_EMAIL=superadmin@dentor.in
SUPER_ADMIN_PASSWORD=

# 0 = no demo clinic/data (production default). 1 = seed demo data (development).
SEED_DEMO=0

# JWT_EXPIRE_MINUTES=720
# CORS_ORIGINS=
# MAX_BODY_BYTES=16777216

# ---- Mobile apps ----
# OTP text messages for the patient app. Leave empty to refuse OTP requests (sign-up,
# OTP login and password reset stay unavailable). "webhook" POSTs {to, message, purpose}
# to SMS_WEBHOOK_URL with "Authorization: Bearer <SMS_WEBHOOK_TOKEN>".
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# Four-digit email codes (staff and patient password reset, staff sign-up). Development uses
# "console" (the code is logged and returned to the app). Production must use "webhook", which
# POSTs {to, subject, text, purpose} to EMAIL_WEBHOOK_URL with "Authorization: Bearer
# <EMAIL_WEBHOOK_TOKEN>"; left empty, email codes are refused and password sign-in still works.
# EMAIL_PROVIDER=webhook
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=

# Push notifications. Leave empty to keep notifications in-app only. "webhook" POSTs
# {devices: [{token, platform}], title, body, data} to PUSH_WEBHOOK_URL with
# "Authorization: Bearer <PUSH_WEBHOOK_TOKEN>" (your FCM / APNs adapter).
# PUSH_PROVIDER=webhook
# PUSH_WEBHOOK_URL=
# PUSH_WEBHOOK_TOKEN=

# PATIENT_ACCESS_MINUTES=60
# REFRESH_TOKEN_DAYS=30
# OTP_TTL_SECONDS=300
# OTP_MAX_PER_HOUR=5
